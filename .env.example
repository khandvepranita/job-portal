# ==========================================
# Local Development Environment Variables
# Copy this file to .env and fill in required values
# ==========================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/jobportal_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security Configuration (Must be at least 256 bits / 32 bytes)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_unique_256_bit_random_jwt_secret_here

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8081/api
